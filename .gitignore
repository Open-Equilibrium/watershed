# Build artifacts (Rust / Cargo workspace). Cargo.lock is intentionally tracked.
**/target/

# Flow Agent runtime state & logs (see docs/concept/V-Spec_FlowAgent.html, SECURITY.md)
**/.flow/sessions/
**/.flow/logs/
flow-agent/fixtures/**/out/
# Node is dev tooling only (clawpatch via package.json); the product has no Node runtime (ADR-0001)
node_modules/
.pnpm-store/
.clawpatch/

# Secrets / local environment — never commit (see SECURITY.md)
.env
.env.*
*.local

# Python bytecode (e.g. .codex/hooks/ scripts)
__pycache__/
*.pyc
pytest-cache-files-*/
.codex-logs/
.tmp/
.tmp-git-objects/

# OS cruft
.DS_Store
Thumbs.db

# Editor / IDE local files
*.swp
.idea/
.vscode/

# Generated local assets
output/
