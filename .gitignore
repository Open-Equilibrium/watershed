# Build artifacts (Rust / Cargo workspace). Cargo.lock is intentionally tracked.
**/target/

flow-agent/fixtures/**/out/
# Node artifacts; Watershed has no Node product-runtime dependency (ADR-0001).
node_modules/
.pnpm-store/
.clawpatch/

# Secrets / local environment — never commit (see SECURITY.md)
.env
.env.*
*.local

# Python bytecode
__pycache__/
*.pyc
pytest-cache-files-*/
.codex-logs/
.tmp/
.tmp-git-objects/

# OS cruft
.DS_Store
Thumbs.db

# Editor / IDE local files
*.swp
.idea/
.vscode/

# Generated local assets
output/
