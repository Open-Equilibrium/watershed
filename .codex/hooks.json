{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && node \"$repo_root/scripts/run-python.mjs\" \"$repo_root/.codex/hooks/pre_tool_use_guard.py\"",
            "commandWindows": "$repoRoot = git rev-parse --show-toplevel; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node \"$repoRoot/scripts/run-python.mjs\" \"$repoRoot/.codex/hooks/pre_tool_use_guard.py\"",
            "statusMessage": "Checking command against protected-path policy",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && node \"$repo_root/scripts/run-python.mjs\" \"$repo_root/.codex/hooks/stop_closeout_check.py\"",
            "commandWindows": "$repoRoot = git rev-parse --show-toplevel; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node \"$repoRoot/scripts/run-python.mjs\" \"$repoRoot/.codex/hooks/stop_closeout_check.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
