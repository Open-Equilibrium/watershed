{
  "$id": "https://open-equilibrium.org/watershed/schemas/script/v0/registry-block.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "M1.1 contract schema for one Watershed registry block file. The parser also enforces semantic reference, recursion, value, and byte limits.",
  "oneOf": [
    { "required": ["tool"] },
    { "required": ["instruction"] },
    { "required": ["phase"] },
    { "required": ["flow"] }
  ],
  "properties": {
    "instruction": { "$ref": "#/$defs/instruction" },
    "flow": { "$ref": "#/$defs/flow" },
    "phase": { "$ref": "#/$defs/phase" },
    "tool": { "$ref": "#/$defs/tool" }
  },
  "$defs": {
    "allowed_parameter": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "value_type": { "const": "string" } },
            "required": ["value_type"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["allowed_values"] },
                { "required": ["min"] },
                { "required": ["max"] }
              ]
            },
            "required": ["value_pattern", "max_length"]
          }
        },
        {
          "if": {
            "properties": { "value_type": { "const": "enum" } },
            "required": ["value_type"]
          },
          "then": {
            "properties": {
              "allowed_values": { "items": { "type": "string" }, "minItems": 1, "type": "array" }
            },
            "not": {
              "anyOf": [
                { "required": ["value_pattern"] },
                { "required": ["max_length"] },
                { "required": ["min"] },
                { "required": ["max"] }
              ]
            },
            "required": ["allowed_values"]
          },
          "else": {
            "not": { "required": ["allowed_values"] }
          }
        },
        {
          "if": {
            "properties": { "value_type": { "const": "integer" } },
            "required": ["value_type"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["allowed_values"] },
                { "required": ["value_pattern"] },
                { "required": ["max_length"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "value_type": { "const": "none" } },
            "required": ["value_type"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["allowed_values"] },
                { "required": ["value_pattern"] },
                { "required": ["max_length"] },
                { "required": ["min"] },
                { "required": ["max"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "value_type": { "const": "workspace-relative-path" } },
            "required": ["value_type"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["allowed_values"] },
                { "required": ["min"] },
                { "required": ["max"] }
              ]
            }
          }
        }
      ],
      "properties": {
        "allowed_values": { "items": { "type": "string" }, "type": "array" },
        "max": { "maximum": 9223372036854775807, "minimum": -9223372036854775808, "type": "integer" },
        "max_length": { "maximum": 65535, "minimum": 0, "type": "integer" },
        "min": { "maximum": 9223372036854775807, "minimum": -9223372036854775808, "type": "integer" },
        "name": { "pattern": "^--[A-Za-z0-9][A-Za-z0-9_-]*$", "type": "string" },
        "required": { "type": "boolean" },
        "value_pattern": { "type": "string" },
        "value_type": { "enum": ["none", "string", "integer", "workspace-relative-path", "enum"] }
      },
      "required": ["name", "value_type", "required"],
      "type": "object"
    },
    "block_id": {
      "not": { "pattern": "^(con|prn|aux|nul|com[1-9]|lpt[1-9])$" },
      "pattern": "^[a-z0-9_-]{1,128}$",
      "type": "string"
    },
    "block_name": { "maxLength": 256, "minLength": 1, "type": "string" },
    "cidr_allow": {
      "additionalProperties": false,
      "properties": {
        "cidr": { "$ref": "#/$defs/cidr" },
        "kind": { "const": "cidr" },
        "port": { "maximum": 65535, "minimum": 1, "type": "integer" },
        "transport": { "enum": ["tcp", "udp"] }
      },
      "required": ["kind", "transport", "cidr", "port"],
      "type": "object"
    },
    "cidr": {
      "anyOf": [
        { "$ref": "#/$defs/ipv4_cidr" },
        { "$ref": "#/$defs/ipv6_cidr" }
      ]
    },
    "instruction": {
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/block_id" },
        "name": { "$ref": "#/$defs/block_name" },
        "parameters": { "items": { "$ref": "#/$defs/instruction_parameter" }, "type": "array" },
        "prompt": { "description": "Maximum 65,536 UTF-8 bytes enforced when loaded.", "minLength": 1, "type": "string" }
      },
      "required": ["id", "name", "prompt"],
      "type": "object"
    },
    "ipv4_cidr": {
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])$",
      "type": "string"
    },
    "ipv6_cidr": {
      "pattern": "^((([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4})|(([0-9A-Fa-f]{1,4}:){1,7}:)|(([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4})|(([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2})|(([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3})|(([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4})|(([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5})|([0-9A-Fa-f]{1,4}:)((:[0-9A-Fa-f]{1,4}){1,6})|(:((:[0-9A-Fa-f]{1,4}){1,7}|:)))/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$",
      "type": "string"
    },
    "flow": {
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/block_id" },
        "name": { "$ref": "#/$defs/block_name" },
        "phase_refs": { "items": { "type": "string" }, "minItems": 1, "type": "array" },
        "subflow_refs": { "items": { "type": "string" }, "type": "array" },
        "transitions": { "items": { "$ref": "#/$defs/transition" }, "type": "array" }
      },
      "required": ["id", "name", "phase_refs"],
      "type": "object"
    },
    "network": {
      "oneOf": [
        { "const": "deny" },
        {
          "additionalProperties": false,
          "properties": {
            "allow": { "items": { "$ref": "#/$defs/cidr_allow" }, "type": "array" },
            "default": { "const": "deny" }
          },
          "required": ["default", "allow"],
          "type": "object"
        }
      ]
    },
    "own_script_command": { "pattern": "^script:[a-z0-9_-]{1,128}$", "type": "string" },
    "phase": {
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/block_id" },
        "instruction_refs": { "items": { "type": "string" }, "type": "array" },
        "loop": { "$ref": "#/$defs/phase_loop" },
        "name": { "$ref": "#/$defs/block_name" },
        "output": { "$ref": "#/$defs/value_contract" },
        "phase_refs": { "items": { "type": "string" }, "type": "array" },
        "result_from": { "minLength": 1, "type": "string" },
        "tool_refs": { "items": { "type": "string" }, "type": "array" },
        "transitions": { "items": { "$ref": "#/$defs/transition" }, "type": "array" }
      },
      "required": ["id", "name", "instruction_refs", "tool_refs", "output"],
      "type": "object"
    },
    "predefined_command": {
      "additionalProperties": false,
      "properties": {
        "argv": { "items": { "type": "string" }, "type": "array" },
        "command_id": { "pattern": "^[a-z][a-z0-9_-]{0,63}$", "type": "string" }
      },
      "required": ["command_id", "argv"],
      "type": "object"
    },
    "flow_value": {
      "oneOf": [
        { "$ref": "#/$defs/flow_value_boolean" },
        { "$ref": "#/$defs/flow_value_integer" },
        { "$ref": "#/$defs/flow_value_string" },
        { "$ref": "#/$defs/flow_value_list" },
        { "$ref": "#/$defs/flow_value_map" },
        { "$ref": "#/$defs/flow_value_session_object" }
      ]
    },
    "flow_value_boolean": {
      "additionalProperties": false,
      "properties": {
        "type": { "const": "boolean" },
        "value": { "type": "boolean" }
      },
      "required": ["type", "value"],
      "type": "object"
    },
    "flow_value_integer": {
      "additionalProperties": false,
      "properties": {
        "type": { "const": "integer" },
        "value": { "pattern": "^(0|-?[1-9][0-9]*)$", "type": "string" }
      },
      "required": ["type", "value"],
      "type": "object"
    },
    "flow_value_list": {
      "additionalProperties": false,
      "properties": {
        "type": { "const": "list" },
        "value": { "items": { "$ref": "#/$defs/flow_value" }, "maxItems": 1024, "type": "array" }
      },
      "required": ["type", "value"],
      "type": "object"
    },
    "flow_value_map": {
      "additionalProperties": false,
      "properties": {
        "type": { "const": "map" },
        "value": {
          "additionalProperties": { "$ref": "#/$defs/flow_value" },
          "maxProperties": 1024,
          "propertyNames": { "maxLength": 256, "minLength": 1 },
          "type": "object"
        }
      },
      "required": ["type", "value"],
      "type": "object"
    },
    "flow_value_session_object": {
      "additionalProperties": false,
      "properties": {
        "type": { "const": "session-object" },
        "value": { "pattern": "^session-object:sha256:[0-9a-f]{64}$", "type": "string" }
      },
      "required": ["type", "value"],
      "type": "object"
    },
    "flow_value_string": {
      "additionalProperties": false,
      "properties": {
        "type": { "const": "string" },
        "value": { "type": "string" }
      },
      "required": ["type", "value"],
      "type": "object"
    },
    "instruction_parameter": {
      "additionalProperties": false,
      "properties": {
        "name": { "pattern": "^[a-z][a-z0-9_-]{0,63}$", "type": "string" },
        "value_contract": { "$ref": "#/$defs/value_contract" }
      },
      "required": ["name", "value_contract"],
      "type": "object"
    },
    "phase_loop": {
      "additionalProperties": false,
      "properties": {
        "max_iterations": { "maximum": 32, "minimum": 1, "type": "integer" },
        "until": { "$ref": "#/$defs/value_predicate" }
      },
      "required": ["max_iterations", "until"],
      "type": "object"
    },
    "transition": {
      "additionalProperties": false,
      "properties": {
        "from_phase_ref": { "minLength": 1, "type": "string" },
        "to_phase_ref": { "minLength": 1, "type": "string" },
        "when": { "$ref": "#/$defs/value_predicate" }
      },
      "required": ["from_phase_ref", "to_phase_ref", "when"],
      "type": "object"
    },
    "value_contract": {
      "oneOf": [
        { "$ref": "#/$defs/value_contract_boolean" },
        { "$ref": "#/$defs/value_contract_integer" },
        { "$ref": "#/$defs/value_contract_string" },
        { "$ref": "#/$defs/value_contract_list" },
        { "$ref": "#/$defs/value_contract_map" },
        { "$ref": "#/$defs/value_contract_session_object" }
      ]
    },
    "value_contract_boolean": {
      "additionalProperties": false,
      "properties": { "type": { "const": "boolean" } },
      "required": ["type"],
      "type": "object"
    },
    "value_contract_integer": {
      "additionalProperties": false,
      "properties": {
        "max": { "maximum": 9223372036854775807, "minimum": -9223372036854775808, "type": "integer" },
        "min": { "maximum": 9223372036854775807, "minimum": -9223372036854775808, "type": "integer" },
        "type": { "const": "integer" }
      },
      "required": ["type"],
      "type": "object"
    },
    "value_contract_list": {
      "additionalProperties": false,
      "properties": {
        "items": { "$ref": "#/$defs/value_contract" },
        "max_items": { "maximum": 1024, "minimum": 0, "type": "integer" },
        "type": { "const": "list" }
      },
      "required": ["type", "items"],
      "type": "object"
    },
    "value_contract_map": {
      "additionalProperties": false,
      "properties": {
        "fields": { "items": { "$ref": "#/$defs/value_field_contract" }, "maxItems": 1024, "type": "array" },
        "type": { "const": "map" }
      },
      "required": ["type", "fields"],
      "type": "object"
    },
    "value_contract_session_object": {
      "additionalProperties": false,
      "properties": { "type": { "const": "session-object" } },
      "required": ["type"],
      "type": "object"
    },
    "value_contract_string": {
      "additionalProperties": false,
      "properties": {
        "max_length": { "maximum": 65535, "minimum": 0, "type": "integer" },
        "type": { "const": "string" }
      },
      "required": ["type"],
      "type": "object"
    },
    "value_field_contract": {
      "additionalProperties": false,
      "properties": {
        "name": { "maxLength": 256, "minLength": 1, "type": "string" },
        "required": { "type": "boolean" },
        "value_contract": { "$ref": "#/$defs/value_contract" }
      },
      "required": ["name", "required", "value_contract"],
      "type": "object"
    },
    "value_path_segment": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": { "field": { "maxLength": 256, "minLength": 1, "type": "string" } },
          "required": ["field"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "index": { "maximum": 65535, "minimum": 0, "type": "integer" } },
          "required": ["index"],
          "type": "object"
        }
      ]
    },
    "value_predicate": {
      "additionalProperties": false,
      "properties": {
        "equals": { "$ref": "#/$defs/flow_value" },
        "path": { "items": { "$ref": "#/$defs/value_path_segment" }, "type": "array" }
      },
      "required": ["path", "equals"],
      "type": "object"
    },
    "tool": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "tool_kind": { "const": "predefined-command" } },
            "required": ["tool_kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["script_runtime"] },
                { "required": ["script_body"] }
              ]
            },
            "properties": { "command": { "$ref": "#/$defs/predefined_command" } }
          }
        },
        {
          "if": {
            "properties": { "tool_kind": { "const": "own-script" } },
            "required": ["tool_kind"]
          },
          "then": {
            "properties": {
              "command": { "$ref": "#/$defs/own_script_command" },
              "script_body": { "description": "Maximum 65,536 UTF-8 bytes enforced when loaded.", "minLength": 1, "type": "string" },
              "script_runtime": { "const": "posix-sh" }
            },
            "required": ["script_runtime", "script_body"]
          }
        }
      ],
      "properties": {
        "allowed_parameters": { "items": { "$ref": "#/$defs/allowed_parameter" }, "type": "array" },
        "command": {
          "oneOf": [
            { "$ref": "#/$defs/predefined_command" },
            { "$ref": "#/$defs/own_script_command" }
          ]
        },
        "id": { "$ref": "#/$defs/block_id" },
        "max_concurrent_processes_and_threads": { "maximum": 4294967295, "minimum": 1, "type": "integer" },
        "name": { "$ref": "#/$defs/block_name" },
        "network": { "$ref": "#/$defs/network" },
        "read_only_mounts": { "items": { "type": "string" }, "maxItems": 64, "type": "array" },
        "runtime_profile": { "default": "exact", "enum": ["exact", "host-system-read"] },
        "script_body": { "description": "Maximum 65,536 UTF-8 bytes enforced when loaded.", "type": "string" },
        "script_runtime": { "const": "posix-sh" },
        "tool_kind": { "enum": ["predefined-command", "own-script"] },
        "writable_mounts": { "items": { "type": "string" }, "maxItems": 64, "type": "array" }
      },
      "required": ["id", "name", "tool_kind", "command", "allowed_parameters", "max_concurrent_processes_and_threads", "read_only_mounts", "writable_mounts", "network"],
      "type": "object"
    }
  },
  "type": "object"
}
